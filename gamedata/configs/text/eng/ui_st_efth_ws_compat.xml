<?xml version="1.0" encoding="windows-1251"?>
<string_table>
    <string id="ui_mcm_menu_efth_ws_compat"><text>EFTH Weapon Sway</text></string>
    <string id="ui_mcm_efth_ws_compat_general"><text>General</text></string>
    <string id="ui_mcm_efth_ws_compat_advanced"><text>Advanced (Custom preset)</text></string>
    <string id="ui_mcm_efth_ws_compat_efth_patch"><text>Enable EFTH integration</text></string>
    <string id="ui_mcm_efth_ws_compat_efth_patch_desc"><text>Multiply Weapon Sway by arm injury severity. Weapon Sway must also be enabled.</text></string>
    <string id="ui_mcm_efth_ws_compat_balance_preset"><text>Balance preset</text></string>
    <string id="ui_mcm_efth_ws_compat_balance_preset_desc"><text>Relaxed, Balanced or Hardcore overrides the advanced penalty sliders. Select Custom to use advanced values.</text></string>
    <string id="ui_mcm_efth_ws_compat_overall_strength"><text>Overall injury strength</text></string>
    <string id="ui_mcm_efth_ws_compat_overall_strength_desc"><text>Scales the injury penalty from 0% to 200%. Default: 100%.</text></string>
    <string id="ui_mcm_efth_ws_compat_smooth_transitions"><text>Smooth transitions</text></string>
    <string id="ui_mcm_efth_ws_compat_smooth_transitions_desc"><text>Changes the EFTH modifier gradually when an arm is injured or recovers.</text></string>
    <string id="ui_mcm_efth_ws_compat_damage_grace"><text>Damage grace range</text></string>
    <string id="ui_mcm_efth_ws_compat_damage_grace_desc"><text>Arm damage below this fraction adds no acute injury penalty. Default: 15%.</text></string>
    <string id="ui_mcm_efth_ws_compat_acute_strength"><text>Acute injury penalty</text></string>
    <string id="ui_mcm_efth_ws_compat_acute_strength_desc"><text>Maximum penalty for current damage on one arm. Default: 3.00.</text></string>
    <string id="ui_mcm_efth_ws_compat_recovery_strength"><text>Recovery impairment penalty</text></string>
    <string id="ui_mcm_efth_ws_compat_recovery_strength_desc"><text>Penalty for a reduced current maximum HP after surgery. Default: 0.30.</text></string>
    <string id="ui_mcm_efth_ws_compat_destroyed_strength"><text>Destroyed arm penalty</text></string>
    <string id="ui_mcm_efth_ws_compat_destroyed_strength_desc"><text>Additional penalty while an arm has zero HP. Default: 1.50.</text></string>
    <string id="ui_mcm_efth_ws_compat_fracture_strength"><text>Fracture penalty</text></string>
    <string id="ui_mcm_efth_ws_compat_fracture_strength_desc"><text>Additional penalty for an EFTH arm fracture. Default: 0.30.</text></string>
    <string id="ui_mcm_efth_ws_compat_painkiller_relief"><text>Painkiller relief</text></string>
    <string id="ui_mcm_efth_ws_compat_painkiller_relief_desc"><text>Fraction of destroyed-arm and fracture penalties suppressed while an EFTH painkiller is active. Acute injury and surgical recovery still apply. Balanced default: 75%.</text></string>
    <string id="ui_mcm_efth_ws_compat_max_multiplier"><text>Maximum health multiplier</text></string>
    <string id="ui_mcm_efth_ws_compat_max_multiplier_desc"><text>Caps the EFTH multiplier before Weapon Sway applies its own camera power cap. Default: 6.00. Custom allows up to 15.</text></string>
    <string id="ui_mcm_efth_ws_compat_injury_smoothing"><text>Injury smoothing (seconds)</text></string>
    <string id="ui_mcm_efth_ws_compat_injury_smoothing_desc"><text>Response time when injury increases the penalty. Default: 0.15 seconds.</text></string>
    <string id="ui_mcm_efth_ws_compat_recovery_smoothing"><text>Recovery smoothing (seconds)</text></string>
    <string id="ui_mcm_efth_ws_compat_recovery_smoothing_desc"><text>Response time when healing reduces the penalty. Default: 0.60 seconds.</text></string>
</string_table>
