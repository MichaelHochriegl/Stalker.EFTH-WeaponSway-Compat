-- EFTH modifier for bvcx Weapon Sway 1.11. Keep this filename for existing installs.
local installed = false
local callbacks_registered = false
local previous_power
local smoothed
local last_time
local telemetry = {}

local function reset()
    smoothed = nil
    last_time = nil
    telemetry = {}
end

local function smooth(target, settings)
    local now = time_global and time_global() or nil
    if not settings.smooth_transitions or not now or not smoothed or not last_time
        or now < last_time or now - last_time > 2000 then
        smoothed = target
    else
        local duration = target > smoothed and settings.injury_smoothing or settings.recovery_smoothing
        if duration <= 0 then
            smoothed = target
        else
            local alpha = 1 - math.exp(-(now - last_time) / (duration * 1000))
            smoothed = smoothed + (target - smoothed) * alpha
        end
    end
    last_time = now
    smoothed = math.max(1, math.min(settings.max_multiplier, smoothed))
    return smoothed
end

local function modified_power(wpn, scoped)
    local base = previous_power(wpn, scoped)
    local settings = efth_ws_compat_mcm.get_settings()
    if not settings.enabled then
        reset()
        return base
    end

    local left, right = efth_ws_health.read_arms()
    if not left or not right then
        reset()
        return base
    end

    local result = efth_ws_calculator.calculate(left, right, settings, efth_ws_health.painkiller_active())
    local multiplier = smooth(result.multiplier, settings)

    telemetry = {
        left = left, right = right, result = result, smoothed = multiplier,
        base = base, modified = (type(base) == "number" and base or 1) * multiplier,
        weapon = wpn and wpn.section and wpn:section() or nil,
        scoped = scoped,
        time = time_global and time_global() or nil,
    }

    -- Weapon Sway uses `or 1` when the stance factor is unavailable.
    return (type(base) == "number" and base or 1) * multiplier
end

function get_telemetry()
    return telemetry
end

function reset_state()
    reset()
end

function on_option_change()
    efth_ws_compat_mcm.invalidate()
    reset()
end

function install_hook()
    if not installed and zzzz_weapon_sway and type(zzzz_weapon_sway.get_body_state_power) == "function" then
        previous_power = zzzz_weapon_sway.get_body_state_power
        zzzz_weapon_sway.get_body_state_power = modified_power
        installed = true
    end
end

function on_game_start()
    efth_ws_compat_mcm.invalidate()
    reset()
    install_hook()
    if not callbacks_registered then
        RegisterScriptCallback("on_option_change", on_option_change)
        RegisterScriptCallback("actor_on_net_destroy", reset_state)
        RegisterScriptCallback("actor_on_first_update", install_hook)
        callbacks_registered = true
    end
end
