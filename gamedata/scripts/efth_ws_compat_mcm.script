-- Settings and presets. Existing `efth_patch` MCM key is retained for saved settings.
local defaults = {
    efth_patch = true, balance_preset = 2, overall_strength = 1,
    smooth_transitions = true,
    damage_grace = 0.15, acute_strength = 3.0, recovery_strength = 0.30,
    destroyed_strength = 1.50, fracture_strength = 0.30, painkiller_relief = 0.75,
    max_multiplier = 6.0, injury_smoothing = 0.15, recovery_smoothing = 0.6,
}

local presets = {
    [1] = { damage_grace = 0.20, acute_strength = 1.8, recovery_strength = 0.20,
        destroyed_strength = 0.8, fracture_strength = 0.15,
        painkiller_relief = 0.85, max_multiplier = 3.8 },
    [2] = defaults,
    [3] = { damage_grace = 0.10, acute_strength = 4.5, recovery_strength = 0.40,
        destroyed_strength = 2.5, fracture_strength = 0.45,
        painkiller_relief = 0.60, max_multiplier = 8.5 },
}

local cached

function get_config(key)
    local fallback = defaults[key]
    if not ui_mcm then return fallback end
    local value = ui_mcm.get("efth_ws_compat/" .. key)
    if value == nil then return fallback end
    return value
end

function invalidate()
    cached = nil
end

function get_settings()
    if cached then return cached end
    local settings = {
        enabled = get_config("efth_patch"),
        overall_strength = get_config("overall_strength"),
        smooth_transitions = get_config("smooth_transitions"),
        injury_smoothing = get_config("injury_smoothing"),
        recovery_smoothing = get_config("recovery_smoothing"),
    }
    local preset = presets[tonumber(get_config("balance_preset"))]
    for _, key in ipairs({ "damage_grace", "acute_strength", "recovery_strength",
        "destroyed_strength", "fracture_strength", "painkiller_relief", "max_multiplier" }) do
        settings[key] = preset and preset[key] or get_config(key)
    end
    cached = settings
    return settings
end

function on_mcm_load()
    return { id = "efth_ws_compat", sh = true, gr = {
        {id = "general", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_efth_ws_compat_general", size = {512, 40}, spacing = 12},
        {id = "efth_patch", type = "check", val = 1, def = defaults.efth_patch},
        {id = "balance_preset", type = "list", val = 2, def = defaults.balance_preset,
            content = {{1, "Relaxed"}, {2, "Balanced"}, {3, "Hardcore"}, {4, "Custom"}}, no_str = true},
        {id = "overall_strength", type = "track", val = 2, min = 0, max = 2, step = 0.05, def = defaults.overall_strength},
        {id = "smooth_transitions", type = "check", val = 1, def = defaults.smooth_transitions},
        {id = "advanced", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_efth_ws_compat_advanced", size = {512, 40}, spacing = 12},
        {id = "damage_grace", type = "track", val = 2, min = 0, max = 0.5, step = 0.01, def = defaults.damage_grace},
        {id = "acute_strength", type = "track", val = 2, min = 0, max = 8, step = 0.05, def = defaults.acute_strength},
        {id = "recovery_strength", type = "track", val = 2, min = 0, max = 1, step = 0.01, def = defaults.recovery_strength},
        {id = "destroyed_strength", type = "track", val = 2, min = 0, max = 5, step = 0.05, def = defaults.destroyed_strength},
        {id = "fracture_strength", type = "track", val = 2, min = 0, max = 1, step = 0.01, def = defaults.fracture_strength},
        {id = "painkiller_relief", type = "track", val = 2, min = 0, max = 1, step = 0.05, def = defaults.painkiller_relief},
        {id = "max_multiplier", type = "track", val = 2, min = 1, max = 15, step = 0.1, def = defaults.max_multiplier},
        {id = "injury_smoothing", type = "track", val = 2, min = 0, max = 2, step = 0.05, def = defaults.injury_smoothing},
        {id = "recovery_smoothing", type = "track", val = 2, min = 0, max = 3, step = 0.05, def = defaults.recovery_smoothing},
    }}
end
